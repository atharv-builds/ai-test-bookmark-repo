{
  "manifest_version": 3,
  "name": "Bookmark Organizer",
  "version": "0.1.0",
  "description": "Tidies your bookmarks with one click, using Chrome's on-device AI (Gemini Nano).",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
